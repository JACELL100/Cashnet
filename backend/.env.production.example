# Render / Docker production environment for the backend
# Copy to .env or set these variables in Render dashboard

PORT=8000
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:your_password@your_host:5432/postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
PRIVATE_KEY=your_private_key_here
ENABLE_BLOCKCHAIN_TXS=false

GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-120b

COINDESK_API_KEY=your_coindesk_key

JWT_SECRET=replace_with_a_long_random_secret
PROVISION_SECRET=replace_with_a_secure_provision_secret

CORS_ALLOWED_ORIGINS=https://your-vercel-app.vercel.app,https://your-domain.com

# Contract addresses after deployment
ACCESS_CONTROL_ADDRESS=0x0000000000000000000000000000000000000000
IDENTITY_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
CREDIT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
COLLATERAL_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
LENDING_POOL_ADDRESS=0x0000000000000000000000000000000000000000
LIQUIDITY_POOL_ADDRESS=0x0000000000000000000000000000000000000000
PALLADIUM_ADDRESS=0x0000000000000000000000000000000000000000
BADASSIUM_ADDRESS=0x0000000000000000000000000000000000000000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=CashNet Threat Monitor
ALERT_EMAIL_ENABLED=true
